{
  "name": "ivorysql-ide",
  "displayName": "IvorySQL PL/iSQL Developer IDE",
  "description": "PL/iSQL Developer extension for IvorySQL database (Oracle mode) - Highlighting, Intellisense, Formatting, DAP Debugging & Git Version Sync",
  "version": "0.1.0",
  "publisher": "ivorysql-community",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:plisql",
    "onCommand:ivorysql.connect",
    "onCommand:ivorysql.deployToDb"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ivorysql-explorer",
          "title": "IvorySQL PL/iSQL IDE",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "ivorysql-explorer": [
        {
          "id": "ivorysql-connections",
          "name": "Database Connections"
        }
      ]
    },
    "languages": [
      {
        "id": "plisql",
        "aliases": [
          "PL/iSQL",
          "plisql",
          "IvorySQL PL/iSQL"
        ],
        "extensions": [
          ".pkh",
          ".pkb",
          ".pls",
          ".plsql",
          ".sql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plisql",
        "scopeName": "source.plisql",
        "path": "./syntaxes/plisql.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ivorysql.connect",
        "title": "IvorySQL: Connect to Database",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.newSqlScript",
        "title": "New SQL Query Window",
        "category": "IvorySQL",
        "icon": "$(file-code)"
      },
      {
        "command": "ivorysql.addConnection",
        "title": "Add Database Connection",
        "icon": "$(add)"
      },
      {
        "command": "ivorysql.editConnection",
        "title": "Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "ivorysql.refreshConnections",
        "title": "Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "ivorysql.deleteConnection",
        "title": "Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "ivorysql.executeQuery",
        "title": "IvorySQL: Execute Selected SQL Query",
        "category": "IvorySQL",
        "icon": "$(play)"
      },
      {
        "command": "ivorysql.viewTableDdl",
        "title": "View Table DDL",
        "category": "IvorySQL",
        "icon": "$(file-code)"
      },
      {
        "command": "ivorysql.selectTop100",
        "title": "Select Top 100 Rows",
        "category": "IvorySQL",
        "icon": "$(table)"
      },
      {
        "command": "ivorysql.reportTablespaces",
        "title": "IvorySQL: Report - Tablespace & Disk Storage",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.reportLocks",
        "title": "IvorySQL: Report - Lock & Deadlock Dependencies",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.reportSlowQueries",
        "title": "IvorySQL: Report - Top Slow Queries",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.reportInvalidObjects",
        "title": "IvorySQL: Report - Invalid / Error Objects",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.reportSessions",
        "title": "IvorySQL: Report - Session & Client Statistics",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.reportHitRatio",
        "title": "IvorySQL: Report - Cache & Index Hit Ratio",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.checkOracleMode",
        "title": "IvorySQL: Check Oracle Mode Status",
        "category": "IvorySQL",
        "icon": "$(verified)"
      },
      {
        "command": "ivorysql.showActiveSessions",
        "title": "IvorySQL: Show Active Database Sessions",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.connectSelected",
        "title": "Connect to Database",
        "icon": "$(plug)"
      },
      {
        "command": "ivorysql.disconnect",
        "title": "IvorySQL: Disconnect from Database",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.syncDiff",
        "title": "IvorySQL: Compare File with Database Source",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.deployToDb",
        "title": "IvorySQL: Deploy/Compile to Database (Git First)",
        "category": "IvorySQL"
      },
      {
        "command": "ivorysql.switchHeaderBody",
        "title": "IvorySQL: Switch Package Header / Body",
        "category": "IvorySQL"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ivorysql.newSqlScript",
          "when": "view == ivorysql-connections",
          "group": "navigation"
        },
        {
          "command": "ivorysql.addConnection",
          "when": "view == ivorysql-connections",
          "group": "navigation"
        },
        {
          "command": "ivorysql.refreshConnections",
          "when": "view == ivorysql-connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ivorysql.connectSelected",
          "when": "view == ivorysql-connections && viewItem == connectionItem",
          "group": "inline"
        },
        {
          "command": "ivorysql.editConnection",
          "when": "view == ivorysql-connections && viewItem == connectionItem",
          "group": "inline"
        },
        {
          "command": "ivorysql.deleteConnection",
          "when": "view == ivorysql-connections && viewItem == connectionItem",
          "group": "inline"
        },
        {
          "command": "ivorysql.selectTop100",
          "when": "view == ivorysql-connections && (viewItem == tableItem || viewItem == viewItem)",
          "group": "1_actions"
        },
        {
          "command": "ivorysql.viewTableDdl",
          "when": "view == ivorysql-connections && (viewItem == tableItem || viewItem == viewItem)",
          "group": "1_actions"
        },
        {
          "command": "ivorysql.viewTableDdl",
          "when": "view == ivorysql-connections && (viewItem == packageItem || viewItem == procedureItem || viewItem == functionItem)",
          "group": "1_actions"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ivorysql.executeQuery",
        "key": "f9",
        "mac": "f9",
        "when": "editorTextFocus"
      },
      {
        "command": "ivorysql.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "ivorysql.switchHeaderBody",
        "key": "alt+o",
        "mac": "cmd+option+o",
        "when": "editorTextFocus && editorLangId == plisql"
      },
      {
        "command": "ivorysql.deployToDb",
        "key": "f8",
        "when": "editorTextFocus && editorLangId == plisql"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "IvorySQL Configuration",
      "properties": {
        "ivorysql.connection.host": {
          "type": "string",
          "default": "localhost",
          "description": "IvorySQL database host"
        },
        "ivorysql.connection.port": {
          "type": "number",
          "default": 5432,
          "description": "IvorySQL database port"
        },
        "ivorysql.connection.database": {
          "type": "string",
          "default": "ivorysql",
          "description": "IvorySQL database name"
        },
        "ivorysql.connection.user": {
          "type": "string",
          "default": "ivorysql",
          "description": "IvorySQL database user"
        },
        "ivorysql.connection.password": {
          "type": "string",
          "default": "",
          "description": "IvorySQL database password"
        },
        "ivorysql.versionControl.strictGitCheck": {
          "type": "boolean",
          "default": true,
          "description": "Block compilation if database source differs from local Git repository"
        },
        "ivorysql.versionControl.autoCommitBeforeDeploy": {
          "type": "boolean",
          "default": true,
          "description": "Automatically commit uncommitted local changes before compiling/deploying to DB"
        },
        "ivorysql.format.keywordCase": {
          "type": "string",
          "enum": ["Uppercase", "Lowercase", "Preserve"],
          "default": "Uppercase",
          "description": "Preferred letter case for PL/iSQL keywords during formatting"
        },
        "ivorysql.format.tabSize": {
          "type": "number",
          "default": 2,
          "description": "Number of indentation spaces used by PL/iSQL formatter"
        },
        "ivorysql.editor.enableHoverSchema": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltip to preview database table columns and data types"
        },
        "ivorysql.editor.enableRealtimeCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time database schema Intellisense completions"
        },
        "ivorysql.dataGrid.maxResultRows": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of rows returned in SQL Query Webview data grid"
        },
        "ivorysql.dataGrid.queryTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Database query timeout in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/pg": "^8.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "pg": "^8.11.0",
    "simple-git": "^3.19.0",
    "vscode-languageclient": "^8.1.0",
    "vscode-languageserver": "^8.1.0"
  }
}
