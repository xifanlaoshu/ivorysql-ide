-- IvorySQL PL/iSQL Package Header Sample
CREATE OR REPLACE PACKAGE emp_pkg IS

  -- 过程与函数声明
  PROCEDURE add_employee(
    p_emp_id   IN NUMBER,
    p_emp_name IN VARCHAR2,
    p_salary   IN NUMBER
  );

  FUNCTION get_employee_salary(
    p_emp_id IN NUMBER
  ) RETURN NUMBER;

  PROCEDURE print_employee_info(
    p_emp_id IN NUMBER
  );

  -- 游标过程声明 (使用原生标准游标类型 refcursor)
  PROCEDURE get_employee_list(
    p_cursor OUT ref cursor
  );

END emp_pkg;
